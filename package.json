{
  "name": "daily-react-kitchen-sink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.92.2",
    "@daily-co/daily-react": "^0.26.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jotai": "^2.12.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.1"
  },
  "scripts": {
    "dev": "vite --host",
    "server": "node server/index.ts",
    "dev:all": "concurrently -n vite,server -c cyan,green \"npm run dev\" \"npm run server\"",
    "register-webhook": "node server/register-webhook.ts",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "eslint src/",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:server": "node --test \"server/**/*.test.ts\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tsconfig/vite-react": "^3.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^5.2.11",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-mkcert": "^1.17.4",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
