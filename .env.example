# Room the whiteboard demo joins. Defaults to https://hush.daily.co/demo.
VITE_DAILY_ROOM_URL=

# Meeting token for the whiteboard publisher (the second daily-js instance).
# Mint it with: ./scripts/recording.sh token
VITE_DAILY_WHITEBOARD_TOKEN=

# Daily REST API key for the domain above. Used by scripts/recording.sh only,
# never by the browser bundle.
DAILY_API_KEY=
